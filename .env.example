# --- User & Permission Settings ---
# Host 側の UID/GID を `id -u`, `id -g` で確認して設定
UID=1000
GID=1000

# --- Repository Path Settings ---
# stock-ops リポジトリの戦略とデータの場所 (相対パスまたは絶対パス)
EXTERNAL_STRATEGY_PATH=../stock-ops/config/strategy
EXTERNAL_DATA_PATH=../stock-ops/data

# --- Application Settings ---
# 分析対象期間やログレベル等を必要に応じて追加
# LOG_LEVEL=INFO
